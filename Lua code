-- LocalScript -> StarterPlayer > StarterPlayerScripts
-- Dev/testing tool for your own game: ESP, aim assist, hitbox control + custom UI.
-- RightShift toggles the menu. Hold Right Mouse Button to aim.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local lp = Players.LocalPlayer
local camera = workspace.CurrentCamera

-- Same allow-list as the server script
local ALLOWED = {
	-- [123456789] = true,
}
if not (RunService:IsStudio() or lp.UserId == game.CreatorId or ALLOWED[lp.UserId]) then
	return
end

local remote = ReplicatedStorage:WaitForChild("DevToolsEvent")

local state = {
	esp = false,
	aimbot = false,
	hitbox = false,
	hitboxSize = 10,
	fov = 150,
	smooth = 0.25,
	teamCheck = true,
	wallCheck = true,
}

