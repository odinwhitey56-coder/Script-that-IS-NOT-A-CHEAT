-- LocalScript -> StarterPlayer > StarterPlayerScripts  (your own game only)
-- RightShift = show/hide menu | Hold RMB = aim
local ALLOWED = {} -- friends/testers: [123456789] = true,

local P, R, U, Rep = game:GetService("Players"), game:GetService("RunService"), game:GetService("UserInputService"), game:GetService("ReplicatedStorage")
local lp = P.LocalPlayer
if not (R:IsStudio() or lp.UserId == game.CreatorId or ALLOWED[lp.UserId]) then return end
local cam = workspace.CurrentCamera
local S = {esp=false, aim=false, hb=false, size=10, fov=150, smooth=0.25, team=true, wall=true}
local OFFC, ONC = Color3.fromRGB(50,50,64), Color3.fromRGB(80,200,120)

-- UI ---------------------------------------------------------------
local gui = Instance.new("ScreenGui"); gui.Name="DevTools"; gui.ResetOnSpawn=false; gui.Parent=lp:WaitForChild("PlayerGui")
local main = Instance.new("Frame"); main.Size=UDim2.fromOffset(240,330); main.Position=UDim2.fromOffset(40,120)
main.BackgroundColor3=Color3.fromRGB(24,24,32); main.BorderSizePixel=0; main.Parent=gui
Instance.new("UICorner",main).CornerRadius=UDim.new(0,10)
local st = Instance.new("UIStroke",main); st.Color=Color3.fromRGB(110,90,255); st.Thickness=1.5
local bar = Instance.new("TextLabel"); bar.Size=UDim2.new(1,0,0,32); bar.BackgroundColor3=Color3.fromRGB(110,90,255); bar.BorderSizePixel=0
bar.Text="  Dev Tools"; bar.TextXAlignment=Enum.TextXAlignment.Left; bar.Font=Enum.Font.GothamBold; bar.TextSize=16; bar.TextColor3=Color3.new(1,1,1); bar.Parent=main
Instance.new("UICorner",bar).CornerRadius=UDim.new(0,10)
local list = Instance.new("Frame"); list.Position=UDim2.fromOffset(10,42); list.Size=UDim2.new(1,-20,1,-52); list.BackgroundTransparency=1; list.Parent=main
Instance.new("UIListLayout",list).Padding=UDim.new(0,7)

local drag, ds, sp
bar.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag,ds,sp=true,i.Position,main.Position end end)
U.InputChanged:Connect(function(i) if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
	local d=i.Position-ds; main.Position=UDim2.new(sp.X.Scale,sp.X.Offset+d.X,sp.Y.Scale,sp.Y.Offset+d.Y) end end)
U.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=false end end)
U.InputBegan:Connect(function(i,p) if not p and i.KeyCode==Enum.KeyCode.RightShift then main.Visible=not main.Visible end end)

local function toggle(text,key,cb)
	local b=Instance.new("TextButton"); b.Size=UDim2.new(1,0,0,30); b.BorderSizePixel=0; b.Font=Enum.Font.GothamMedium; b.TextSize=14; b.TextColor3=Color3.new(1,1,1); b.Parent=list
	Instance.new("UICorner",b).CornerRadius=UDim.new(0,6)
	local function r() b.Text=text..": "..(S[key] and "ON" or "OFF"); b.BackgroundColor3=S[key] and ONC or OFFC end
	r(); b.MouseButton1Click:Connect(function() S[key]=not S[key]; r(); if cb then cb() end end)
end
local function number(text,key,lo,hi,cb)
	local row=Instance.new("Frame"); row.Size=UDim2.new(1,0,0,30); row.BackgroundTransparency=1; row.Parent=list
	local l=Instance.new("TextLabel"); l.Size=UDim2.fromScale(.6,1); l.BackgroundTransparency=1; l.Text=text; l.TextXAlignment=Enum.TextXAlignment.Left
	l.Font=Enum.Font.Gotham; l.TextSize=14; l.TextColor3=Color3.fromRGB(220,220,230); l.Parent=row
	local t=Instance.new("TextBox"); t.Size=UDim2.fromScale(.4,1); t.Position=UDim2.fromScale(.6,0); t.BackgroundColor3=OFFC; t.BorderSizePixel=0
	t.Text=tostring(S[key]); t.Font=Enum.Font.GothamMedium; t.TextSize=14; t.TextColor3=Color3.new(1,1,1); t.ClearTextOnFocus=false; t.Parent=row
	Instance.new("UICorner",t).CornerRadius=UDim.new(0,6)
	t.FocusLost:Connect(function() local n=tonumber(t.Text); if n then S[key]=math.clamp(n,lo,hi); if cb then cb() end end; t.Text=tostring(S[key]) end)
end

-- Hitbox (also tells the optional server script, if present) ---------
local function syncServer() local e=Rep:FindFirstChild("DevToolsEvent"); if e then e:FireServer(S.hb,S.size) end end
toggle("ESP","esp"); toggle("Aimbot (hold RMB)","aim"); toggle("Hitboxes","hb",syncServer)
toggle("Team Check","team"); toggle("Wall Check","wall")
number("Hitbox Size","size",2,30,syncServer); number("Aim FOV","fov",20,800); number("Smoothness","smooth",0.05,1)

-- ESP + local hitbox loop ------------------------------------------
R.Heartbeat:Connect(function()
	local mine = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	for _, p in ipairs(P:GetPlayers()) do
		local c = p.Character
		if p ~= lp and c then
			local hum, hrp, head = c:FindFirstChildOfClass("Humanoid"), c:FindFirstChild("HumanoidRootPart"), c:FindFirstChild("Head")
			if S.esp and hum and head then
				if not c:FindFirstChild("DT_HL") then
					local h=Instance.new("Highlight"); h.Name="DT_HL"; h.FillColor=Color3.fromRGB(255,70,70); h.FillTransparency=.6
					h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; h.Parent=c
					local b=Instance.new("BillboardGui"); b.Name="DT_TAG"; b.Size=UDim2.fromOffset(140,34); b.StudsOffset=Vector3.new(0,2.5,0); b.AlwaysOnTop=true; b.Adornee=head; b.Parent=c
					local t=Instance.new("TextLabel"); t.Name="L"; t.Size=UDim2.fromScale(1,1); t.BackgroundTransparency=1; t.Font=Enum.Font.GothamBold
					t.TextSize=13; t.TextColor3=Color3.new(1,1,1); t.TextStrokeTransparency=.4; t.Parent=b
				end
				local b = c:FindFirstChild("DT_TAG")
				if b and hrp and mine then b.L.Text=string.format("%s\n%d HP | %dm",p.DisplayName,hum.Health,(mine.Position-hrp.Position).Magnitude) end
			elseif not S.esp then
				for _, n in ipairs({"DT_HL","DT_TAG"}) do local o=c:FindFirstChild(n); if o then o:Destroy() end end
			end
			if hrp then
				if S.hb then hrp:SetAttribute("DT",true); hrp.Size=Vector3.one*S.size; hrp.Transparency=.7; hrp.CanCollide=false
				elseif hrp:GetAttribute("DT") then hrp:SetAttribute("DT",nil); hrp.Size=Vector3.new(2,2,1); hrp.Transparency=1 end
			end
		end
	end
end)

-- Aim assist --------------------------------------------------------
local ring = Instance.new("Frame"); ring.AnchorPoint=Vector2.new(.5,.5); ring.BackgroundTransparency=1; ring.Parent=gui
Instance.new("UICorner",ring).CornerRadius=UDim.new(1,0); Instance.new("UIStroke",ring).Color=Color3.new(1,1,1)

local function seen(head,c)
	local rp=RaycastParams.new(); rp.FilterType=Enum.RaycastFilterType.Exclude; rp.FilterDescendantsInstances={lp.Character}
	local o=cam.CFrame.Position; local r=workspace:Raycast(o,head.Position-o,rp)
	return r==nil or r.Instance:IsDescendantOf(c)
end
local function target()
	local m, best, bd = U:GetMouseLocation(), nil, S.fov
	for _, p in ipairs(P:GetPlayers()) do
		local c=p.Character; local hum=c and c:FindFirstChildOfClass("Humanoid"); local head=c and c:FindFirstChild("Head")
		if p~=lp and hum and head and hum.Health>0 and not (S.team and lp.Team and p.Team==lp.Team) then
			local v,on=cam:WorldToViewportPoint(head.Position)
			if on then local d=(Vector2.new(v.X,v.Y)-m).Magnitude
				if d<bd and (not S.wall or seen(head,c)) then best,bd=head,d end end
		end
	end
	return best
end
R.RenderStepped:Connect(function()
	cam=workspace.CurrentCamera; ring.Visible=S.aim
	if not S.aim then return end
	local m=U:GetMouseLocation(); ring.Size=UDim2.fromOffset(S.fov*2,S.fov*2); ring.Position=UDim2.fromOffset(m.X,m.Y)
	if U:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		local t=target(); if t then cam.CFrame=cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position,t.Position),S.smooth) end
	end
end)
